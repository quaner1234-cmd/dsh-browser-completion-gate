# macOS
.DS_Store

# Local installs for the standard bundle (npm install installs the dsh-tools
# peer; CI installs fresh, no lockfile is committed)
node_modules/

# Machine-specific preflight backup (copies of local ~/.dsh web profile config)
preflight-backup/

# Deterministic fixture runtime state (state file + simulated downloads).
# Recreated by POST /api/reset; never committed. The grader reads this dir.
fixtures/state/